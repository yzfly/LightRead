<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- iOS 专属 Info.plist 条目, tauri ios build 时并入 gen/apple 的 Info.plist (gen/apple 不入库)。
     文档类型 (「用轻阅打开」) 由 tauri.conf.json 的 fileAssociations 生成, 不在这里重复。 -->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>轻阅</string>
	<!-- 听书切到后台 / 锁屏后继续播放 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- 「文件」App 与数据线里能看到书库目录, 可直接拷书、取备份 -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- 金句卡片存相册: 只申请「添加」权限, 不读相册 -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>把金句卡片保存到相册。</string>
	<!-- 只用系统 HTTPS, 无自带加密算法 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
